// 定義一個全域或共用的抓取統計函式
function loadStatistics() {
    axios.get('/api/attractions/statistics')
        .then(response => {
            const data = response.data;
            console.log('統計資料抓取成功：', data);

            // 1. 更新上方總數數字
            const totalAttractionsEl = document.querySelector('[x-text="totalAttractions"]');
            if (totalAttractionsEl) totalAttractionsEl.innerText = data.total_attractions;

            const totalCategoriesEl = document.querySelector('[x-text="totalCategories"]');
            if (totalCategoriesEl) totalCategoriesEl.innerText = data.total_categories;

            // 2. 渲染或更新各分類圓餅圖 (建議加上 chart 實例銷毀機制避免重複渲染)
            const categoryCtx = document.getElementById('categoryChart');
            if (categoryCtx) {
                // 如果已經有舊圖表，先銷毀它再建立新圖表，避免畫面疊圖
                if (window.myCategoryChart) {
                    window.myCategoryChart.destroy();
                }

                window.myCategoryChart = new Chart(categoryCtx.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: Object.keys(data.category_counts),
                        datasets: [{
                            data: Object.values(data.category_counts),
                            backgroundColor: ['#3B82F6', '#10B981', '#F59E0B', '#EF4444', '#8B5CF6', '#EC4899']
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
                });
            }
        })
        .catch(error => {
            console.error('抓取統計資料失敗：', error);
        });
}

// 頁面載入時執行一次
document.addEventListener("DOMContentLoaded", function () {
    loadStatistics();
});